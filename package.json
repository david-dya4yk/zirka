{
  "name": "zirka",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "scss:types": "typed-scss-modules \"src/**/*.module.scss\" --exportType default --nameFormat none --quoteType single --includePaths src/styles --additionalData \"@use 'index' as *;\" --logLevel error",
    "scss:types:watch": "typed-scss-modules \"src/**/*.module.scss\" --exportType default --nameFormat none --quoteType single --includePaths src/styles --additionalData \"@use 'index' as *;\" --logLevel error --watch",
    "predev": "npm run scss:types",
    "dev": "next dev",
    "prebuild": "npm run scss:types",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "npm run scss:types",
    "typecheck": "tsc --noEmit",
    "prelint": "npm run scss:types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:styles:fix": "stylelint \"src/**/*.scss\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run lint:styles && npm run format:check"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "sass": "^1.105.0",
    "stylelint": "^17.15.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typed-scss-modules": "^8.1.1",
    "typescript": "^5",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
